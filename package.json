{
  "name": "fde-quest",
  "private": true,
  "description": "FDE Quest: co-op FDE interview prep game. Static site + Vercel functions, plus a Capacitor Android app.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "web": "node scripts/build-web.mjs",
    "android:sync": "node scripts/build-web.mjs && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android",
    "android:release": "node scripts/release-android.mjs"
  },
  "dependencies": {
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/app": "7.1.2",
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@capacitor/haptics": "7.0.5",
    "@capacitor/local-notifications": "7.0.7",
    "@capacitor/push-notifications": "7.0.7",
    "@capacitor/splash-screen": "7.0.5"
  }
}
